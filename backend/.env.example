# Copy to backend/.env and fill in. .env is git-ignored — never commit real values.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=messenger_hub
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT signing key — at least 256 bits.
#   openssl rand -base64 48
JWT_SECRET=

# AES key for messenger credentials stored in the database.
# Must decode to 16, 24 or 32 bytes.
#   openssl rand -base64 32
# Rotating this key makes existing stored credentials unreadable and every
# connected messenger account has to be reconnected.
ENCRYPTION_KEY=

# Telegram bot (optional — only needed for bot features)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=messenger_hub_bot
