# Copy to .env and fill in. Read by docker compose only — running the backend by hand
# still uses backend/.env.
#
# Generate both secrets with:
#   openssl rand -base64 32

JWT_SECRET=
ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres is created with these on first start. Changing them later does not
# rewrite an existing volume — remove postgres-data if you need a clean database.
DB_NAME=messenger_hub
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── Telegram ──────────────────────────────────────────────────────────────────
# From my.telegram.org → API development tools. These belong to the client library,
# not to a bot, and the Telegram service will not start without them.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: only needed for the bot-based login flow.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=messenger_hub_bot

# ── Ports and addresses ───────────────────────────────────────────────────────
FRONTEND_PORT=5273
BACKEND_PORT=8279

# Where the browser reaches the backend, and which origin the backend trusts.
# Both must agree with the ports above.
VITE_API_URL=http://localhost:8279
FRONTEND_ORIGIN=http://localhost:5273

# ── Local models ──────────────────────────────────────────────────────────────
# Where the backend container reaches Ollama. The default is the Ollama already
# running on the host (models pulled there are reused). Use http://ollama:11434
# together with `docker compose --profile ollama up` to run it in a container.
OLLAMA_URL=http://host.docker.internal:11434
# Whisper size: small handles Ukrainian acceptably; base is faster but mishears.
WHISPER_MODEL=small
